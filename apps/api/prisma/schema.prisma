// SH-HRMS — Steel Horizon Human Resource Management System
// Data model covering projects, resources, attendance/OT, leave, tasks and invoicing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  PM
  EM // Engineering Manager — scoped to projects like a PM, and approves resource assignments
  RESOURCE
}

enum ResourceType {
  SH // Internal Steel Horizon employee
  EXTERNAL // Supplied by a service provider (e.g. Preesoft)
}

/// Coarse grouping a person belongs to on a delivery roster — the axis the
/// client's timesheet organises people by. `Resource.designation` stays the
/// specific job title ("Senior Backend Developer"); this is the bucket.
enum ResourceFunction {
  DEVELOPER
  SQA
  TEAM_LEAD
  DESIGNER
  DEVOPS
  BUSINESS_ANALYST
  OTHER
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// How bad the problem is, as opposed to `TaskPriority`, which is what we're
/// doing about it. Kept as a separate axis on purpose: a cosmetic bug can be
/// urgent before a launch, and a critical one can be deferred.
enum TaskSeverity {
  S1 // Critical
  S2 // Major
  S3 // Minor
  S4 // Cosmetic
}

/// Kinds of leave a resource can request. Deliberately short — OTHER carries
/// anything the list doesn't name, described in the request's reason.
enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  UNPAID
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

/// Currencies an invoice can be raised in.
enum Currency {
  MYR // Malaysian ringgit
  PKR // Pakistani rupee
}

enum NotificationType {
  OT_SUBMITTED
  OT_DECIDED
  INVOICE_SUBMITTED
  INVOICE_DECIDED
  TASK_ASSIGNED
  ASSIGNMENT_REQUESTED
  ASSIGNMENT_DECIDED
  LEAVE_SUBMITTED
  LEAVE_DECIDED
  GENERIC
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Login identity. Every person who can sign in has exactly one User.
/// A RESOURCE user is additionally backed by a Resource profile.
model User {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String  @unique
  passwordHash String
  name         String
  role         Role
  phone        String?
  avatarColor  String? // deterministic accent for avatars in the UI
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resource         Resource?  @relation("ResourceAccount")
  createdResources Resource[] @relation("ResourceCreatedBy")

  managedProjects     ProjectManager[]
  engineeredProjects  ProjectEngineeringManager[]
  assignmentsMade     ResourceAssignment[]        @relation("AssignmentAssignedBy")
  assignmentRequests  AssignmentRequest[]         @relation("AssignmentRequestedBy")
  assignmentDecisions AssignmentRequest[]         @relation("AssignmentDecidedBy")
  attendances         Attendance[]
  tasksAssigned       Task[]                      @relation("TaskAssignee")
  tasksCreated        Task[]                      @relation("TaskCreatedBy")
  overtimeDecisions   OvertimeRequest[]           @relation("OvertimeDecidedBy")
  leaveDecisions      LeaveRequest[]              @relation("LeaveDecidedBy")
  invoices            Invoice[]                   @relation("InvoiceOwner")
  invoiceDecisions    Invoice[]                   @relation("InvoiceDecidedBy")
  auditLogs           AuditLog[]
  notifications       Notification[]

  @@index([role])
}

// ---------------------------------------------------------------------------
// Resources
// ---------------------------------------------------------------------------

model Resource {
  id                String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  employeeCode      String            @unique
  name              String
  email             String            @unique
  phone             String?
  designation       String? // company-wide job title; per-project titles live on ResourceAssignment
  /// Named `jobFunction` rather than `function` to keep the generated client
  /// free of a reserved word. Surfaces as "Function" throughout the UI.
  jobFunction       ResourceFunction?
  location          String?
  type              ResourceType
  /// Service Provider supplying this resource. Required when type = EXTERNAL, and
  /// must be null when type = SH — enforced in ResourcesService.
  serviceProviderId String?           @db.Uuid
  /// Seniority *we* assign to an external resource, independent of the title the
  /// service provider gives them. Only meaningful when type = EXTERNAL.
  internalSeniority String?
  status            ResourceStatus    @default(ACTIVE)
  joinedAt          DateTime?
  notes             String?

  /// Login account. Nullable so a resource can be recorded before credentials are issued.
  userId String? @unique @db.Uuid
  user   User?   @relation("ResourceAccount", fields: [userId], references: [id], onDelete: SetNull)

  serviceProvider ServiceProvider? @relation(fields: [serviceProviderId], references: [id], onDelete: Restrict)

  /// Who onboarded this resource — drives PM scoping (a PM owns resources they created).
  createdById String? @db.Uuid
  createdBy   User?   @relation("ResourceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  assignments        ResourceAssignment[]
  assignmentRequests AssignmentRequest[]
  leaveRequests      LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([jobFunction])
  @@index([createdById])
  @@index([serviceProviderId])
}

// ---------------------------------------------------------------------------
// Clients & Projects
// ---------------------------------------------------------------------------

/// A company that supplies us external resources (e.g. Preesoft).
/// Mirror of Client: a Client gives us projects, a Service Provider gives us people.
model ServiceProvider {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String  @unique
  contactName  String?
  contactEmail String?
  contactPhone String?
  notes        String?

  resources Resource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String  @unique
  contactName  String?
  contactEmail String?
  contactPhone String?
  notes        String?

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        String        @unique
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?

  clientId String @db.Uuid
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  /// Co-management: a project may carry several PMs, and PMs can be swapped
  /// without touching the resources placed on the project itself.
  managers    ProjectManager[]
  /// Engineering Managers on this project. They hold the same project scope as a
  /// PM and are the people who approve a PM's resource-assignment requests.
  engineers   ProjectEngineeringManager[]
  modules     Module[]
  assignments ResourceAssignment[]
  requests    AssignmentRequest[]
  tasks       Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

model ProjectManager {
  projectId  String   @db.Uuid
  userId     String   @db.Uuid
  assignedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

/// Mirror of ProjectManager for the EM role. Kept as its own table rather than a
/// discriminator column so existing PM queries stay untouched and a project can
/// carry both kinds of manager independently.
model ProjectEngineeringManager {
  projectId  String   @db.Uuid
  userId     String   @db.Uuid
  assignedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Module {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  description String?

  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  subModules  SubModule[]
  assignments ResourceAssignment[]
  requests    AssignmentRequest[]
  tasks       Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
}

model SubModule {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  description String?

  moduleId String @db.Uuid
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  assignments ResourceAssignment[]
  requests    AssignmentRequest[]
  tasks       Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, name])
}

/// Places a resource on a project, optionally narrowed to a module / sub-module.
/// A resource may hold many assignments at once, across projects.
model ResourceAssignment {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  resourceId String   @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  moduleId String? @db.Uuid
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  subModuleId String?    @db.Uuid
  subModule   SubModule? @relation(fields: [subModuleId], references: [id], onDelete: Cascade)

  /// Title held on *this* project, independent of Resource.designation — the
  /// same person can be a lead here and a developer elsewhere. Optional: a
  /// placement is meaningful without it, and several people are often placed at
  /// once from the project screen.
  roleOnProject String?

  allocationPct Int       @default(100)
  startDate     DateTime?
  endDate       DateTime?

  assignedById String? @db.Uuid
  assignedBy   User?   @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  /// Set when this placement came out of an approved AssignmentRequest.
  request AssignmentRequest?

  createdAt DateTime @default(now())

  @@index([resourceId])
  @@index([projectId])
  @@index([moduleId])
  @@index([subModuleId])
}

/// A PM's request to place a resource on a project. The placement itself does not
/// exist until an Engineering Manager on that project approves — approval is what
/// creates the ResourceAssignment, so a PENDING row grants no access to anything.
///
/// Admins and the project's own EMs bypass this: they assign directly.
model AssignmentRequest {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  resourceId String   @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  moduleId String? @db.Uuid
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  subModuleId String?    @db.Uuid
  subModule   SubModule? @relation(fields: [subModuleId], references: [id], onDelete: Cascade)

  // The placement being asked for — copied onto the ResourceAssignment verbatim
  // when approved, so what was approved is exactly what takes effect.
  roleOnProject String?
  allocationPct Int       @default(100)
  startDate     DateTime?
  endDate       DateTime?

  status ApprovalStatus @default(PENDING)
  /// Why the PM wants this person.
  reason String?

  requestedById String @db.Uuid
  requestedBy   User   @relation("AssignmentRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)

  decidedById  String?   @db.Uuid
  decidedBy    User?     @relation("AssignmentDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?

  /// The placement this request produced. Null while pending or rejected, and
  /// nulled again if the assignment is later removed.
  assignmentId String?             @unique @db.Uuid
  assignment   ResourceAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([projectId, status])
  @@index([requestedById])
  @@index([resourceId])
}

// ---------------------------------------------------------------------------
// Attendance & Overtime
// ---------------------------------------------------------------------------

model Attendance {
  id     String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String   @db.Uuid
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Calendar day the shift belongs to (local date, midnight UTC).
  date   DateTime @db.Date

  checkInAt  DateTime
  checkOutAt DateTime?

  /// Unpaid break deducted from elapsed time. Default 1 hour per policy.
  breakMinutes Int @default(60)
  /// Elapsed − break, capped at the 8h standard day.
  workMinutes  Int @default(0)
  /// Anything beyond the standard day; requires approval to count as logged.
  otMinutes    Int @default(0)

  note String?

  overtimeRequest OvertimeRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
}

model OvertimeRequest {
  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  attendanceId String         @unique @db.Uuid
  attendance   Attendance     @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  minutes      Int
  status       ApprovalStatus @default(PENDING)
  reason       String?

  decidedById  String?   @db.Uuid
  decidedBy    User?     @relation("OvertimeDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Leave
// ---------------------------------------------------------------------------

/// Time off requested by a resource.
///
/// Leave hangs off **Resource**, not User, because only resources take it — a
/// PM, EM or Admin cannot raise one (enforced in LeaveService). Approval is a
/// single decision by either an Engineering Manager on one of the resource's
/// projects or an Admin; whoever gets there first settles it.
model LeaveRequest {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  resourceId String   @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  type LeaveType

  /// Inclusive range, stored as dates (no time component) so a request means
  /// whole days regardless of the requester's timezone.
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  /// Working days in the range, Mon–Fri, weekends excluded. Computed on the
  /// server and stored, so a request keeps the figure it was approved on even
  /// if the counting rule changes later.
  days Int

  reason String?

  status       ApprovalStatus @default(PENDING)
  decidedById  String?        @db.Uuid
  decidedBy    User?          @relation("LeaveDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resourceId, status])
  @@index([status])
  @@index([startDate])
}

// ---------------------------------------------------------------------------
// Tasks (local tracker mirroring an external ticket system)
// ---------------------------------------------------------------------------

model Task {
  id          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)
  /// Optional: tasks created before severity existed have none, and it isn't
  /// always known when one is raised.
  severity    TaskSeverity?
  dueDate     DateTime?
  completedAt DateTime?

  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  moduleId String? @db.Uuid
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  subModuleId String?    @db.Uuid
  subModule   SubModule? @relation(fields: [subModuleId], references: [id], onDelete: SetNull)

  assigneeId String @db.Uuid
  assignee   User   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)

  createdById String @db.Uuid
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  // Mirror of whatever ticket system the project uses (Jira, Linear, Azure
  // Boards…) — metadata only, captured by hand. No live API integration.
  ticketId  String?
  ticketUrl String?
  mrUrl     String?
  mrTitle   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([severity])
  @@index([dueDate])
}

// ---------------------------------------------------------------------------
// Invoicing (internal SH resources only)
// ---------------------------------------------------------------------------

model Invoice {
  id            String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  /// Currency this invoice is raised in. Totals are only ever summed within a
  /// single currency — see InvoicesService.summary.
  currency      Currency      @default(PKR)

  /// The person raising the invoice. Internal SH resources, PMs and Admins may
  /// invoice; External resources may not (enforced in InvoicesService).
  userId String @db.Uuid
  user   User   @relation("InvoiceOwner", fields: [userId], references: [id], onDelete: Cascade)

  invoiceDate   DateTime
  address       String
  bankName      String
  accountNumber String
  periodFrom    DateTime
  periodTo      DateTime
  notes         String?

  total Decimal @default(0) @db.Decimal(12, 2)

  items InvoiceItem[]

  submittedAt  DateTime?
  decidedById  String?   @db.Uuid
  decidedBy    User?     @relation("InvoiceDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
}

model InvoiceItem {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  invoiceId   String  @db.Uuid
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(10, 2)
  rate        Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  position    Int     @default(0)

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Cross-cutting
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String // denormalised so history survives user deletion
  action     String // e.g. TASK_STATUS_CHANGED, OT_APPROVED, INVOICE_REJECTED
  entityType String // Task | OvertimeRequest | Invoice | ...
  entityId   String
  summary    String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id     String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String           @db.Uuid
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType @default(GENERIC)
  title  String
  body   String?
  link   String?
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
}
