{
  "name": "sh-hrms",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run start:dev -w @sh-hrms/api",
    "dev:web": "npm run dev -w @sh-hrms/web",
    "build": "npm run build -w @sh-hrms/api && npm run build -w @sh-hrms/web",
    "db:migrate": "npm run prisma:migrate -w @sh-hrms/api",
    "db:seed": "npm run prisma:seed -w @sh-hrms/api",
    "db:reset": "npm run prisma:reset -w @sh-hrms/api",
    "db:deploy": "npm run prisma:deploy -w @sh-hrms/api && npm run db:ensure-admin -w @sh-hrms/api",
    "db:ensure-admin": "npm run db:ensure-admin -w @sh-hrms/api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=22"
  }
}
